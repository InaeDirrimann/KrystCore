  "bin": {
    "kryst": "./bin/kryst.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --experimental-strip-types tests/**/*.test.ts"
  },
  "keywords": [
    "krystcore",
    "sdk",
    "rbac",
    "bitmask",
    "ast-rules"
  ],
